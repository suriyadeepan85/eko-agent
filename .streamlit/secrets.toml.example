# Streamlit Cloud secrets configuration
# Copy this to .streamlit/secrets.toml for local testing with secrets
# On Streamlit Cloud: paste this content in App settings > Secrets

# AWS Credentials (required for Streamlit Cloud deployment)
AWS_ACCESS_KEY_ID = "your-access-key-id"
AWS_SECRET_ACCESS_KEY = "your-secret-access-key"
AWS_REGION = "us-east-1"

# Bedrock Model ID (optional, defaults to Claude Sonnet 4.5)
BEDROCK_MODEL_ID = "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
